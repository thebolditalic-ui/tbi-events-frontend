{
  "rewrites": [
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.thebolditalic.com"
        }
      ],
      "destination": "/dashboard.html"
    },
    {
      "source": "/admin",
      "destination": "/dashboard.html"
    },
    {
      "source": "/events",
      "destination": "/admin.html"
    },
    {
      "source": "/queue",
      "destination": "/queue.html"
    },
    {
      "source": "/banners",
      "destination": "/banners.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics.html"
    },
    {
      "source": "/links",
      "destination": "/links.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/api/banner-click",
      "destination": "/api/banner-active?a=click"
    },
    {
      "source": "/api/banner-impression",
      "destination": "/api/banner-active?a=impression"
    },
    {
      "source": "/api/track-event-click",
      "destination": "/api/track-page?t=event-click"
    },
    {
      "source": "/api/track-event-view",
      "destination": "/api/track-page?t=event-view"
    },
    {
      "source": "/api/insert-event",
      "destination": "/api/update-event"
    },
    {
      "source": "/api/delete-event",
      "destination": "/api/update-event"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/disclosures",
      "destination": "/disclosures.html"
    },
    {
      "source": "/social",
      "destination": "/social.html"
    },
    {
      "source": "/news_desk",
      "destination": "/news_desk.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/astrology",
      "destination": "/astrology.html"
    },
    {
      "source": "/games",
      "destination": "/games.html"
    },
    {
      "source": "/social-analytics",
      "destination": "/social-analytics.html"
    },
    {
      "source": "/downloader",
      "destination": "/downloader.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
